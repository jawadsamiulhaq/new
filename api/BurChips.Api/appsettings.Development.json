{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=BurChips;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "SampleDeliveryAreas": true
  },
  "Sms": {
    "Provider": "Log"
  },
  "RateLimits": {
    "OtpPer10Minutes": 1000,
    "StaffLoginPer10Minutes": 1000
  }
}
